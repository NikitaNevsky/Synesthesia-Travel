    <div id="rec759786184" class="r t-rec t-rec_pt_45 t-rec_pb_45 r_hidden r_anim" style="padding-top:45px;padding-bottom:45px; " data-record-type="191"> <!-- T142 -->
      <div class="t142"> <a class="t-btn t-btnflex t-btnflex_type_button t-btnflex_md js-click-stat" href="#rec667552365" data-tilda-event-name="/tilda/click/rec759786184/button1" data-btneffects-first="btneffects-light"> <span class="t-btnflex__text">Создать свой тур</span>
          <div class="t-btn_wrap-effects t-btn_wrap-effects_md">
            <div class="t-btn_effects"></div>
          </div>
        </a> </div>
      <script>
        t_onReady(function () {
          window.setTimeout(function () {
            var rec = document.getElementById('rec759786184');
            if (!rec) return;
            var firstButton = rec.querySelectorAll('.t-btn[data-btneffects-first], .t-submit[data-btneffects-first]');
            Array.prototype.forEach.call(firstButton, function (button) {
              var buttonEffect = button.querySelector('.t-btn_wrap-effects');
              if (!buttonEffect) {
                button.insertAdjacentHTML('beforeend', '<div class="t-btn_wrap-effects"><div class="t-btn_effects"></div></div>');
                buttonEffect = button.querySelector('.t-btn_wrap-effects');
              };
              if (button.offsetWidth > 230) {
                buttonEffect.classList.add('t-btn_wrap-effects_md');
              };
              if (button.offsetWidth > 300) {
                buttonEffect.classList.remove('t-btn_wrap-effects_md');
                buttonEffect.classList.add('t-btn_wrap-effects_lg');
              }
            });
          }, 1000);
        });
      </script>
    </div>
