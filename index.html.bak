          <div class="t396__elem tn-elem tn-elem__7605338571718042903006" data-elem-id="1718042903006" data-elem-type="text" data-field-top-value="82" data-field-left-value="229" data-field-width-value="688" data-field-axisy-value="top" data-field-axisx-value="left" data-field-container-value="grid" data-field-topunits-value="px" data-field-leftunits-value="px" data-field-heightunits-value="" data-field-widthunits-value="px" data-field-fontsize-value="42" data-field-left-res-320-value="21" data-field-width-res-320-value="245" data-field-left-res-480-value="101" data-field-width-res-480-value="279" data-field-fontsize-res-480-value="26" data-field-width-res-640-value="367" data-field-left-res-960-value="164" data-fields="top,left,width,height,container,axisx,axisy,widthunits,leftunits,topunits" style="top: 82px; left: 229px; width: 688px; height: auto; zoom: 1.225;">
            <div class="tn-atom" field="tn_text_1718042903006" style="transform-origin: center center; line-height: 65px;">Приоритеты Synesthesia Travel:</div>
          </div>
          <div class="t396__elem tn-elem tn-elem__7605338571718042921902" data-elem-id="1718042921902" data-elem-type="text" data-field-top-value="160" data-field-left-value="119" data-field-width-value="963" data-field-axisy-value="top" data-field-axisx-value="left" data-field-container-value="grid" data-field-topunits-value="px" data-field-leftunits-value="px" data-field-heightunits-value="" data-field-widthunits-value="px" data-field-fontsize-value="24" data-field-left-res-320-value="11" data-field-width-res-320-value="298" data-field-top-res-480-value="160" data-field-left-res-480-value="10" data-field-width-res-480-value="460" data-field-fontsize-res-480-value="18" data-field-top-res-640-value="190" data-field-left-res-640-value="12" data-field-width-res-640-value="616" data-field-left-res-960-value="87" data-fields="top,left,width,height,container,axisx,axisy,widthunits,leftunits,topunits" style="top: 160px; left: 119px; width: 963px; height: auto; zoom: 1.225;">
            <div class="tn-atom" field="tn_text_1718042921902" style="transform-origin: center center; line-height: 31px;">Помимо сервиса и комфорта, у нас заботятся о сенсорной составляющей путешествия. Мы уделяем внимание таким вопросам путешественника, как:</div>
          </div>
