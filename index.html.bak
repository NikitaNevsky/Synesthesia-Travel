            <div class="tn-atom" field="tn_text_1700070437066" style="line-height: 27px;">Комфорт и качество</div>
          </div>
          <div class="t396__elem tn-elem tn-elem__6678625901700070437071" data-elem-id="1700070437071" data-elem-type="text" data-field-top-value="804" data-field-left-value="50" data-field-width-value="500" data-field-axisy-value="top" data-field-axisx-value="left" data-field-container-value="grid" data-field-topunits-value="px" data-field-leftunits-value="px" data-field-heightunits-value="" data-field-widthunits-value="px" data-field-fontsize-value="18" data-field-top-res-320-value="1172" data-field-left-res-320-value="-562" data-field-width-res-320-value="255" data-field-fontsize-res-320-value="14" data-field-top-res-480-value="625px" data-field-left-res-480-value="60px" data-field-width-res-480-value="378" data-field-top-res-640-value="654px" data-field-left-res-640-value="90px" data-field-width-res-640-value="478" data-field-fontsize-res-640-value="12" data-field-top-res-960-value="457px" data-field-left-res-960-value="370px" data-field-width-res-960-value="238" data-field-fontsize-res-960-value="14" data-fields="top,left,width,height,container,axisx,axisy,widthunits,leftunits,topunits" style="top: 804px; left: 185px; width: 500px; height: auto;">
            <div class="tn-atom" field="tn_text_1700070437071" style="line-height: 28px;"><span class="poss-toggle" role="button" tabindex="0">Подробнее&nbsp;⌄</span><span class="poss-rest">✅ Бесплатно для эксперта (кроме тарифа Т.О.М.А.)<br>✅ Страховка, договор<br>✅ Проживание в новых красивых коттеджах<br>✅ Свой штат (повар, уборка, водители и так далее)<br>✅ Клиентоориентированные организаторы и персонал<br>✅ Профильное образование в индустриях психологии и гостеприимства<br>✅ Непрерывное улучшение условий и повышение качества сервиса<br>✅ Любые легальные аутентичные запросы к отдыху<br><br>Основатель проекта ценит качественный туризм, не раз организовывала путешествия и события со всей эстетикой и мудростью для друзей и близких - и теперь рада создать такие возможности и для других. ❤</span></div>
          </div>
          <div class="t396__elem tn-elem tn-elem__6678625901700070437078" data-elem-id="1700070437078" data-elem-type="shape" data-field-top-value="728" data-field-left-value="621" data-field-height-value="680" data-field-width-value="559" data-field-axisy-value="top" data-field-axisx-value="left" data-field-container-value="grid" data-field-topunits-value="px" data-field-leftunits-value="px" data-field-heightunits-value="px" data-field-widthunits-value="px" data-field-top-res-320-value="1710" data-field-left-res-320-value="-583" data-field-height-res-320-value="670" data-field-width-res-320-value="296" data-field-top-res-480-value="492px" data-field-left-res-480-value="40px" data-field-width-res-480-value="440" data-field-top-res-640-value="520px" data-field-left-res-640-value="70px" data-field-width-res-640-value="540" data-field-top-res-960-value="321px" data-field-left-res-960-value="350px" data-field-width-res-960-value="300" data-fields="width,height,top,left,container,axisx,axisy,widthunits,heightunits,leftunits,topunits" style="width: 559px; left: 756px; top: 728px; height: 680px;">
