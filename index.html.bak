            <div class="tn-atom" field="tn_text_1649338097365" style="line-height: 27px;">Сенсорика и синестезия</div>
          </div>
          <div class="t396__elem tn-elem tn-elem__6678625901649338097348" data-elem-id="1649338097348" data-elem-type="text" data-field-top-value="231" data-field-left-value="50" data-field-width-value="517" data-field-axisy-value="top" data-field-axisx-value="left" data-field-container-value="grid" data-field-topunits-value="px" data-field-leftunits-value="px" data-field-heightunits-value="" data-field-widthunits-value="px" data-field-fontsize-value="18" data-field-top-res-320-value="133" data-field-left-res-320-value="-562" data-field-width-res-320-value="255" data-field-fontsize-res-320-value="14" data-field-top-res-480-value="615" data-field-left-res-480-value="50" data-field-width-res-480-value="378" data-field-top-res-640-value="644" data-field-left-res-640-value="80" data-field-width-res-640-value="478" data-field-fontsize-res-640-value="12" data-field-top-res-960-value="447" data-field-left-res-960-value="360" data-field-width-res-960-value="238" data-field-fontsize-res-960-value="14" data-fields="top,left,width,height,container,axisx,axisy,widthunits,leftunits,topunits" style="top: 231px; left: 185px; width: 517px; height: auto;">
            <div class="tn-atom" field="tn_text_1649338097348" style="line-height: 28px;">Мы обеспечиваем и нужный код сенсорных раздражителей:<br><br><span class="poss-toggle" role="button" tabindex="0">Подробнее&nbsp;⌄</span><span class="poss-rest">✅ Нам надо, чтобы клиент почувствовал благополучие/защищенность/реальное положение дел, находясь на лекции<br>✅ Пусть нас в течение всей программы сопровождает мысль о том, что цель достигнута, и клиент заработал свой первый миллиард. Сделаешь ненавязчиво?<br>✅ Мы хотим как-то ненавязчиво показать клиенту его искомое состояние, мы можем исключить то, что приводит его ко внутреннему конфликту?<br><br>Атрибуты, еда, интерьер и экстерьер, атмосфера, ароматы и аксессуары - мы создаем гармоничные пространства. 💚<br><br></span></div>
          </div>
          <div class="t396__elem tn-elem tn-elem__6678625901700070397684" data-elem-id="1700070397684" data-elem-type="shape" data-field-top-value="168" data-field-left-value="621" data-field-height-value="520" data-field-width-value="559" data-field-axisy-value="top" data-field-axisx-value="left" data-field-container-value="grid" data-field-topunits-value="px" data-field-leftunits-value="px" data-field-heightunits-value="px" data-field-widthunits-value="px" data-field-top-res-320-value="629" data-field-left-res-320-value="-583" data-field-height-res-320-value="470" data-field-width-res-320-value="296" data-field-top-res-480-value="482px" data-field-left-res-480-value="30px" data-field-width-res-480-value="440" data-field-top-res-640-value="510px" data-field-left-res-640-value="60px" data-field-width-res-640-value="540" data-field-top-res-960-value="311px" data-field-left-res-960-value="340px" data-field-width-res-960-value="300" data-fields="width,height,top,left,container,axisx,axisy,widthunits,heightunits,leftunits,topunits" style="width: 559px; left: 756px; top: 168px; height: 520px;">
